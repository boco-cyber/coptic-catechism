# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coptic-catechism?retryWrites=true&w=majority

# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/coptic-catechism

# Server
PORT=5000
NODE_ENV=development

# CORS - allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Arabic verification pipeline — vision transcription providers
# TRANSCRIBE_PROVIDER: gemini | nvidia
TRANSCRIBE_PROVIDER=gemini
GEMINI_API_KEY=<your Google AI Studio key>
NVIDIA_API_KEY=<your NVIDIA NIM key (optional fallback)>

# Admin panel session signing secret — required in production
SESSION_SECRET=<a long random string>
